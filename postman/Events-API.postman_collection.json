  "item": [
    {
      "name": "1. Crear Evento SIN Imagen",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has event data', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('name');",
              "    pm.expect(jsonData).to.have.property('date');",
              "    pm.expect(jsonData).to.have.property('location');",
              "    pm.expect(jsonData).to.have.property('venueName');",
              "    pm.expect(jsonData).to.have.property('eventDetails');",
              "    pm.expect(jsonData).to.have.property('ticketConfigurations');",
              "    ",
              "    // Validate event details structure",
              "    if (jsonData.eventDetails && jsonData.eventDetails.length > 0) {",
              "        const details = jsonData.eventDetails[0];",
              "        pm.expect(details).to.have.property('category');",
              "        pm.expect(details).to.have.property('foodSale');",
              "        pm.expect(details).to.have.property('liquorSale');",
              "        pm.expect(details).to.have.property('reducedMobilityAccess');",
              "        pm.expect(details).to.have.property('pregnantAccess');",
              "    }",
              "});",
              "",
              "pm.test('Save eventId for later use', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.collectionVariables.set('eventId', jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Concierto de Rock sin Imagen\",\n  \"date\": \"2026-06-15T20:00:00Z\",\n  \"location\": \"Estadio Nacional\",\n  \"venueName\": \"Estadio Nacional\",\n  \"eventDetails\": [\n    {\n      \"category\": \"Música\",\n      \"minAge\": 18,\n      \"seating\": \"Numerado\",\n      \"capacity\": 600,\n      \"foodSale\": true,\n      \"liquorSale\": true,\n      \"reducedMobilityAccess\": true,\n      \"pregnantAccess\": true\n    }\n  ],\n  \"ticketConfigurations\": [\n    {\n      \"type\": \"VIP\",\n      \"price\": 150.00,\n      \"currency\": \"USD\",\n      \"quantity\": 100\n    },\n    {\n      \"type\": \"GENERAL\",\n      \"price\": 50.00,\n      \"currency\": \"USD\",\n      \"quantity\": 500\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        },
        "description": "Crear un evento sin imagen adjunta. Incluye detalles completos del evento como categoría, edad mínima, capacidad, y servicios disponibles."
      },
      "response": []
    },
    {
      "name": "2. Crear Evento CON Imagen",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has event with imageUrl', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('name');",
              "    pm.expect(jsonData).to.have.property('venueName');",
              "    pm.expect(jsonData).to.have.property('eventDetails');",
              "    pm.expect(jsonData).to.have.property('imageUrl');",
              "    ",
              "    // Validate event details",
              "    if (jsonData.eventDetails && jsonData.eventDetails.length > 0) {",
              "        const details = jsonData.eventDetails[0];",
              "        pm.expect(details).to.have.property('category');",
              "        pm.expect(details).to.have.property('capacity');",
              "        console.log('Event Details:', details);",
              "    }",
              "    ",
              "    if (jsonData.imageUrl) {",
              "        pm.expect(jsonData.imageUrl).to.be.a('string');",
              "        console.log('Image URL:', jsonData.imageUrl);",
              "    }",
              "});",
              "",
              "pm.test('Save eventId for later use', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.collectionVariables.set('eventId', jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
