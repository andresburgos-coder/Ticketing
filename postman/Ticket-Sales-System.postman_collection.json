                  "            pm.expect(ticket).to.have.property('eventId');",
                  "            pm.expect(ticket).to.have.property('type');",
                  "            pm.expect(ticket).to.have.property('buyerEmail');",
                  "            pm.expect(ticket).to.have.property('price');",
                  "            pm.expect(ticket).to.have.property('currency');",
                  "            pm.expect(ticket).to.have.property('purchaseDate');",
