<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recordatorio - {{eventName}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #f4f4f4;
        }
        
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }
        
        .header {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
            color: white;
            padding: 30px 20px;
            text-align: center;
        }
        
        .header h1 {
            font-size: 28px;
            margin-bottom: 10px;
            font-weight: 300;
        }
        
        .header .emoji {
            font-size: 48px;
            margin-bottom: 15px;
            display: block;
        }
        
        .content {
            padding: 30px 20px;
        }
        
        .greeting {
            font-size: 18px;
            margin-bottom: 20px;
            color: #2c3e50;
        }
        
        .reminder-message {
            background-color: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 30px;
            text-align: center;
        }
        
        .reminder-message .icon {
            font-size: 32px;
            color: #f39c12;
            margin-bottom: 10px;
            display: block;
        }
        
        .reminder-message h2 {
            color: #856404;
            margin-bottom: 10px;
            font-size: 22px;
        }
        
        .reminder-message p {
            color: #856404;
            font-size: 16px;
        }
        
        .event-info {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
            text-align: center;
        }
        
        .event-info h3 {
            font-size: 28px;
            margin-bottom: 20px;
            font-weight: 300;
        }
        
        .event-details {
            display: grid;
            gap: 15px;
        }
        
        .event-detail {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            background-color: rgba(255, 255, 255, 0.1);
            padding: 12px;
            border-radius: 8px;
        }
        
        .event-detail .icon {
            margin-right: 12px;
            font-size: 24px;
        }
        
        .countdown {
            background-color: #e74c3c;
            color: white;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            margin-bottom: 30px;
        }
        
        .countdown h3 {
            font-size: 24px;
            margin-bottom: 10px;
        }
        
        .countdown .time {
            font-size: 36px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .tickets-reminder {
            background-color: #f8f9fa;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
            border-left: 4px solid #667eea;
        }
        
        .tickets-reminder h3 {
            color: #2c3e50;
            font-size: 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }
        
        .tickets-reminder h3 .icon {
            margin-right: 10px;
            color: #667eea;
        }
        
        .ticket-summary {
            display: grid;
            gap: 15px;
        }
        
        .ticket-item {
            background-color: white;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .ticket-code {
            font-family: 'Courier New', monospace;
            font-weight: bold;
            color: #2c3e50;
            font-size: 16px;
        }
        
        .ticket-type {
            background-color: #667eea;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
        }
        
        .checklist {
            background-color: #d4edda;
            border: 1px solid #c3e6cb;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 30px;
        }
        
        .checklist h3 {
            color: #155724;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }
        
        .checklist h3 .icon {
            margin-right: 10px;
            font-size: 20px;
        }
        
        .checklist ul {
            color: #155724;
            padding-left: 20px;
        }
        
        .checklist li {
            margin-bottom: 8px;
            position: relative;
        }
        
        .checklist li::before {
            content: '✓';
            position: absolute;
            left: -20px;
            color: #28a745;
            font-weight: bold;
        }
        
        .cta-button {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .cta-button a {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 30px;
            text-decoration: none;
            border-radius: 25px;
            font-size: 18px;
            font-weight: bold;
            transition: transform 0.2s;
        }
        
        .cta-button a:hover {
            transform: translateY(-2px);
        }
        
        .footer {
            background-color: #2c3e50;
            color: white;
            padding: 30px 20px;
            text-align: center;
        }
        
        .footer h3 {
            margin-bottom: 15px;
            font-size: 18px;
        }
        
        .footer p {
            margin-bottom: 10px;
            color: #bdc3c7;
        }
        
        .footer a {
            color: #3498db;
            text-decoration: none;
        }
        
        .footer a:hover {
            text-decoration: underline;
        }
        
        @media (max-width: 600px) {
            .email-container {
                margin: 0;
                box-shadow: none;
            }
            
            .content {
                padding: 20px 15px;
            }
            
            .event-detail {
                font-size: 16px;
            }
            
            .countdown .time {
                font-size: 28px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- Header -->
        <div class="header">
            <span class="emoji">🔔</span>
            <h1>¡Tu evento se acerca!</h1>
            <p>No olvides tus entradas</p>
        </div>
        
        <!-- Content -->
        <div class="content">
            <!-- Greeting -->
            <div class="greeting">
                Hola {{buyerName}},
            </div>
            
            <!-- Reminder Message -->
            <div class="reminder-message">
                <span class="icon">⏰</span>
                <h2>¡Es hora de prepararse!</h2>
                <p>Tu evento está próximo a comenzar. Asegúrate de tener todo listo.</p>
            </div>
            
            <!-- Event Information -->
            <div class="event-info">
                <h3>{{eventName}}</h3>
                <div class="event-details">
                    <div class="event-detail">
                        <span class="icon">📅</span>
                        <span>{{formatDate eventDate}}</span>
                    </div>
                    {{#if eventStartTime}}
                    <div class="event-detail">
                        <span class="icon">🕐</span>
                        <span>{{formatTime eventStartTime}}{{#if eventEndTime}} - {{formatTime eventEndTime}}{{/if}}</span>
                    </div>
                    {{/if}}
                    <div class="event-detail">
                        <span class="icon">📍</span>
                        <span>{{eventLocation}}</span>
                    </div>
                    {{#if eventVenueName}}
                    <div class="event-detail">
                        <span class="icon">🏢</span>
                        <span>{{eventVenueName}}</span>
                    </div>
                    {{/if}}
                </div>
            </div>
            
            <!-- Countdown (placeholder - would need JavaScript for real countdown) -->
            <div class="countdown">
                <h3>¡Faltan pocas horas!</h3>
                <div class="time">🎭</div>
                <p>Prepárate para una experiencia increíble</p>
            </div>
            
            <!-- Tickets Reminder -->
            <div class="tickets-reminder">
                <h3><span class="icon">🎫</span>Tus Entradas ({{totalTickets}})</h3>
                <div class="ticket-summary">
                    {{#each tickets}}
                    <div class="ticket-item">
                        <div class="ticket-code">{{code}}</div>
                        <div class="ticket-type">{{type}}</div>
                    </div>
                    {{/each}}
                </div>
            </div>
            
            <!-- Checklist -->
            <div class="checklist">
                <h3><span class="icon">📋</span>Lista de Verificación</h3>
                <ul>
                    <li>Revisa que tienes tus entradas (este email o impreso)</li>
                    <li>Lleva tu documento de identidad</li>
                    <li>Llega 30 minutos antes del evento</li>
                    <li>Carga tu teléfono para mostrar el código QR</li>
                    <li>Revisa las restricciones del venue (bolsos, comida, etc.)</li>
                    <li>Planifica tu transporte y estacionamiento</li>
                </ul>
            </div>
            
            <!-- CTA Button -->
            <div class="cta-button">
                <a href="{{websiteUrl}}/my-tickets">Ver Mis Entradas</a>
            </div>
        </div>
        
        <!-- Footer -->
        <div class="footer">
            <h3>{{companyName}}</h3>
            <p>¡Disfruta tu evento!</p>
            <p>¿Necesitas ayuda? Contáctanos en <a href="mailto:{{supportEmail}}">{{supportEmail}}</a></p>
            <p>Visita nuestro sitio web: <a href="{{websiteUrl}}">{{websiteUrl}}</a></p>
            
            <p style="margin-top: 20px; font-size: 12px; color: #95a5a6;">
                Este email fue enviado a {{buyerEmail}}<br>
                © {{companyName}} - Todos los derechos reservados
            </p>
        </div>
    </div>
</body>
</html>